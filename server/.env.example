# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# MongoDB Atlas connection string. Get this from a teammate or the Atlas dashboard
# (Database > Connect > Drivers). Includes the username/password for the DB user.
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-url>/?retryWrites=true&w=majority

# Port the Express server listens on.
PORT=5000

# Secret used to sign JWTs. Any long random string works for local dev —
# generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# How long an issued token stays valid, e.g. 1d, 12h, 30m.
JWT_EXPIRES_IN=1d

# Where the React app is served from. Used to build the activation link inside the
# invite email body HR sends to a new joiner. Vite's dev server default is 5173.
CLIENT_URL=http://localhost:5173
